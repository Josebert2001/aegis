# Aegis Environment Settings
GCP_PROJECT=aegis-fleet-local
GCP_REGION=us-central1

# Model Selection (Hard rules: Gemini 3.5+; never set temperature/top_p/top_k)
MODEL_REGISTRAR=gemini-3.7-flash
MODEL_ASSESSOR=gemini-3.7-flash
MODEL_ADVERSARY=gemini-3.5-flash-lite

# Session Persistence (SQLite for local, Cloud SQL/Spanner if configured)
SESSION_DB_URL=sqlite:///./aegis_sessions.db

# Cloud Service Flags (Default to false for honest local execution)
USE_FIRESTORE=false
EXPORT_TRACES=false
USE_MODEL_ARMOR=false

# HMAC Envelope Signing Key (Ephemerally generated or configured in Secret Manager)
AEGIS_HMAC_SECRET=local-ephemeral-secret-key-32b-min

PORT=8080
HOST=0.0.0.0
